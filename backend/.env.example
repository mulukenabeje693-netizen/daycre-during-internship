NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/daycare
JWT_SECRET=replace-with-a-long-random-backend-secret

# Public HTTPS frontend origin only. Localhost cannot receive Chapa's browser return.
# Use the deployed frontend origin or a secure HTTPS tunnel for local checkout tests.
FRONTEND_URL=http://localhost:3000
# Optional full callback URL on the same origin. If blank, the backend builds the
# /dashboard/parent/payments/success URL from FRONTEND_URL.
CHAPA_RETURN_URL=
# Public HTTPS backend webhook endpoint registered with Chapa (optional for local return-based verification).
CHAPA_CALLBACK_URL=
# Keep this provider secret on the backend. Use the documented sandbox key.
CHAPA_SECRET_KEY=CHAPA_TEST_replace_with_test_secret_key
CHAPA_BASE_URL=https://api.chapa.global/v2
# Runtime safety gate. Set true only after configuring a valid Chapa key.
# The separate MongoDB payment setting still requires an administrator to enable checkout.
ONLINE_PAYMENTS_ENABLED=false
# Optional: set this to the signing secret for the webhook configured at
# https://<your-backend>/api/payments/chapa-webhook in the Chapa dashboard.
CHAPA_WEBHOOK_SECRET=

# Optional manual bank transfer. Bank details are returned to authenticated users
# only when enabled and complete. An administrator must reconcile each transfer.
BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_BANK_NAME=cbe
BANK_TRANSFER_ACCOUNT_NAME=awash
BANK_TRANSFER_ACCOUNT_NUMBER=hibiret
BANK_TRANSFER_INSTRUCTIONS=Please transfer the amount to the specified account.

# Test invoices are restricted to development/test and stay disabled by default.
ALLOW_TEST_INVOICES=false
CHAPA_TEST_INVOICE_AMOUNT=150
DAYCARE_MONTHLY_FEE=
DAYCARE_PLAN_ID=daycare-monthly
